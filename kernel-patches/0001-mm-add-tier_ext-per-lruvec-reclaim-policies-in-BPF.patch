diff --git a/include/linux/tier_ext.h b/include/linux/tier_ext.h
new file mode 100644
index 000000000..cafd5cbb3
--- /dev/null
+++ b/include/linux/tier_ext.h
@@ -0,0 +1,237 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * tier_ext: per-lruvec reclaim policies written in BPF.
+ *
+ * A BPF program implements struct tier_ext_ops (a BPF struct_ops type) and
+ * attaches it to a set of lruvecs, i.e. (memory cgroup, NUMA node) pairs.
+ * Reclaim of those lruvecs consults the policy at a few well-defined decision
+ * points; every other lruvec, and every decision the policy leaves as
+ * TIER_EXT_DEFAULT, keeps the kernel's own behaviour (classic two-list LRU or
+ * MGLRU, whichever is active).
+ *
+ * See design/ in the tier_ext repository for the full rationale.
+ */
+#ifndef _LINUX_TIER_EXT_H
+#define _LINUX_TIER_EXT_H
+
+#include <linux/types.h>
+#include <linux/jump_label.h>
+#include <linux/mmzone.h>
+
+struct folio;
+struct mem_cgroup;
+
+#define TIER_EXT_NAME_LEN	32
+
+/*
+ * Return values of the decision callbacks. Anything a callback returns that
+ * the callback does not accept is treated as TIER_EXT_DEFAULT.
+ */
+enum tier_ext_verdict {
+	/* Do what the kernel would have done without a policy. */
+	TIER_EXT_DEFAULT	= 0,
+	/* folio_scan/folio_reclaim: try to reclaim this folio now. */
+	TIER_EXT_RECLAIM	= 1,
+	/* folio_scan/folio_reclaim: keep this folio in memory for now. */
+	TIER_EXT_KEEP		= 2,
+	/* lruvec_shrink: do not reclaim from this lruvec in this pass. */
+	TIER_EXT_SKIP		= 3,
+};
+
+/* Flags a folio_reclaim verdict may be OR-ed with. */
+enum tier_ext_verdict_flags {
+	/* Reclaim (swap out / drop) rather than demote to a slower node. */
+	TIER_EXT_NO_DEMOTE	= 1U << 8,
+	/* Demote only: if demotion is not possible or fails, keep the folio. */
+	TIER_EXT_DEMOTE_ONLY	= 1U << 9,
+};
+
+#define TIER_EXT_VERDICT_MASK	0xffU
+
+/* Which reclaim implementation is running for the lruvec. */
+enum tier_ext_engine {
+	TIER_EXT_ENGINE_CLASSIC	= 0,	/* active/inactive lists */
+	TIER_EXT_ENGINE_MGLRU	= 1,	/* multi-generational LRU */
+};
+
+/* tier_ext_lruvec_ctx::reclaim_flags and tier_ext_folio_ctx::reclaim_flags */
+enum tier_ext_reclaim_flags {
+	TIER_EXT_RC_KSWAPD	= 1U << 0,	/* background reclaim by kswapd */
+	TIER_EXT_RC_PROACTIVE	= 1U << 1,	/* memory.reclaim / node reclaim */
+	TIER_EXT_RC_CGROUP	= 1U << 2,	/* reclaim targets a memcg (limit hit) */
+};
+
+/* tier_ext_folio_ctx::folio_flags, a snapshot of the folio's state. */
+enum tier_ext_folio_flags {
+	TIER_EXT_F_ANON		= 1U << 0,	/* anonymous / swap-backed */
+	TIER_EXT_F_ACTIVE	= 1U << 1,	/* on an active list (classic) */
+	TIER_EXT_F_REFERENCED	= 1U << 2,	/* PG_referenced */
+	TIER_EXT_F_WORKINGSET	= 1U << 3,	/* PG_workingset */
+	TIER_EXT_F_DIRTY	= 1U << 4,
+	TIER_EXT_F_WRITEBACK	= 1U << 5,
+	TIER_EXT_F_MAPPED	= 1U << 6,	/* mapped into some page table */
+	TIER_EXT_F_SWAPCACHE	= 1U << 7,
+	TIER_EXT_F_UNEVICTABLE	= 1U << 8,
+	TIER_EXT_F_LARGE	= 1U << 9,	/* more than one page */
+};
+
+/* Passed to the per-lruvec callbacks (lruvec_shrink, swappiness). */
+struct tier_ext_lruvec_ctx {
+	u64 cgroup_id;		/* cgroup v2 id of the lruvec's memcg */
+	s32 nid;		/* NUMA node of the lruvec */
+	s32 engine;		/* enum tier_ext_engine */
+	s32 priority;		/* reclaim priority, 12 (gentle) .. 0 (desperate) */
+	s32 swappiness;		/* the kernel's swappiness for this call */
+	u32 reclaim_flags;	/* enum tier_ext_reclaim_flags */
+	u32 __pad;
+	u64 nr_to_reclaim;	/* pages the whole reclaim pass is trying to free */
+	u64 nr_reclaimed;	/* pages freed so far by this reclaim pass */
+	u64 nr_anon;		/* anon pages on this lruvec's LRU lists */
+	u64 nr_file;		/* file pages on this lruvec's LRU lists */
+};
+
+/* Passed to the per-folio callbacks. */
+struct tier_ext_folio_ctx {
+	struct folio *folio;	/* read-only access through BTF */
+	u64 cgroup_id;
+	u64 pfn;		/* first page frame number, stable id while resident */
+	s32 nid;
+	s32 engine;
+	u32 nr_pages;
+	u32 folio_flags;	/* enum tier_ext_folio_flags */
+	s32 lru_gen;		/* MGLRU generation (0..3), -1 if not on MGLRU */
+	s32 lru_refs;		/* MGLRU access counter, 0 if not on MGLRU */
+	s32 lru;		/* folio_scan: enum lru_list being scanned */
+	s32 referenced_ptes;	/* folio_reclaim: young PTEs found by rmap */
+	s32 priority;		/* reclaim priority, -1 outside of reclaim */
+	u32 reclaim_flags;	/* enum tier_ext_reclaim_flags, 0 outside reclaim */
+};
+
+/**
+ * struct tier_ext_ops - a per-lruvec reclaim policy
+ *
+ * All callbacks are optional. A missing callback means "always default".
+ * All callbacks run in atomic context (RCU read side, some with the lruvec
+ * LRU lock held and interrupts disabled) and must not sleep.
+ *
+ * @lruvec_shrink: Reclaim is about to scan this lruvec. Return
+ *	TIER_EXT_SKIP to leave it alone for this pass (ignored at priority 0),
+ *	or TIER_EXT_DEFAULT.
+ * @swappiness: Return the anon/file balance (0..200) to use for this lruvec,
+ *	or a negative value to keep ctx->swappiness.
+ * @folio_scan: The folio sits at the cold end of the lruvec and the scanner
+ *	is deciding whether to take it off the LRU for a reclaim attempt.
+ *	Called with the LRU lock held. RECLAIM: isolate it, bypassing the
+ *	engine's list-level protection (MGLRU tiers). KEEP: rotate it back
+ *	(MGLRU: youngest generation; classic: head of its list).
+ * @folio_reclaim: The folio is isolated and locked, its page table
+ *	references were just counted (ctx->referenced_ptes), and reclaim
+ *	is deciding its fate. RECLAIM: reclaim it regardless of references.
+ *	KEEP: put it back as active. May be OR-ed with TIER_EXT_NO_DEMOTE or
+ *	TIER_EXT_DEMOTE_ONLY. Folios found in VM_LOCKED VMAs or with
+ *	contended rmap locks never reach this callback.
+ * @folio_added: The folio was just added to this lruvec's LRU (fault,
+ *	page cache insertion, putback after a failed reclaim attempt ...).
+ * @folio_accessed: folio_mark_accessed() was called, i.e. a syscall-level
+ *	access to a page cache folio. Page table accesses are only visible
+ *	through @folio_reclaim and the MGLRU generation.
+ * @folio_evicted: Reclaim freed the folio (it is leaving memory). Demoted
+ *	folios are not reported here; they are added to their new lruvec.
+ * @cgroup_id: cgroup v2 id (inode number of the cgroup directory) whose
+ *	memcg's lruvecs this policy controls; 0 means the root cgroup.
+ * @node_mask: bitmask of NUMA nodes (bit n = node n) whose lruvecs this
+ *	policy controls; 0 means every node.
+ * @flags: reserved, must be 0.
+ * @name: human readable name, shown in /sys/kernel/debug/tier_ext.
+ */
+struct tier_ext_ops {
+	s32 (*lruvec_shrink)(struct tier_ext_lruvec_ctx *ctx);
+	s32 (*swappiness)(struct tier_ext_lruvec_ctx *ctx);
+	s32 (*folio_scan)(struct tier_ext_folio_ctx *ctx);
+	s32 (*folio_reclaim)(struct tier_ext_folio_ctx *ctx);
+	void (*folio_added)(struct tier_ext_folio_ctx *ctx);
+	void (*folio_accessed)(struct tier_ext_folio_ctx *ctx);
+	void (*folio_evicted)(struct tier_ext_folio_ctx *ctx);
+
+	u64 cgroup_id;
+	u64 node_mask;
+	u64 flags;
+	char name[TIER_EXT_NAME_LEN];
+};
+
+#ifdef CONFIG_TIER_EXT
+
+DECLARE_STATIC_KEY_FALSE(tier_ext_attached);
+
+/* Cheap check used at every hook site: is a policy attached to @lruvec? */
+static __always_inline bool tier_ext_lruvec(struct lruvec *lruvec)
+{
+	return static_branch_unlikely(&tier_ext_attached) &&
+	       rcu_access_pointer(lruvec->tier_ext);
+}
+
+/* Reclaim-side information the hooks need from struct scan_control. */
+struct tier_ext_reclaim {
+	int engine;
+	int priority;
+	unsigned int flags;
+	unsigned long nr_to_reclaim;
+	unsigned long nr_reclaimed;
+};
+
+bool __tier_ext_lruvec_skip(struct lruvec *lruvec,
+			    const struct tier_ext_reclaim *rc);
+int __tier_ext_swappiness(struct lruvec *lruvec,
+			  const struct tier_ext_reclaim *rc, int swappiness);
+int __tier_ext_folio_scan(struct lruvec *lruvec, struct folio *folio,
+			  const struct tier_ext_reclaim *rc, int lru);
+unsigned int __tier_ext_folio_reclaim(struct lruvec *lruvec,
+				      struct folio *folio,
+				      const struct tier_ext_reclaim *rc,
+				      int referenced_ptes);
+void __tier_ext_folio_added(struct lruvec *lruvec, struct folio *folio);
+void __tier_ext_folio_accessed(struct folio *folio);
+void __tier_ext_folio_evicted(struct folio *folio);
+
+static __always_inline void tier_ext_folio_added(struct lruvec *lruvec,
+						 struct folio *folio)
+{
+	if (tier_ext_lruvec(lruvec))
+		__tier_ext_folio_added(lruvec, folio);
+}
+
+static __always_inline void tier_ext_folio_accessed(struct folio *folio)
+{
+	if (static_branch_unlikely(&tier_ext_attached))
+		__tier_ext_folio_accessed(folio);
+}
+
+static __always_inline void tier_ext_folio_evicted(struct folio *folio)
+{
+	if (static_branch_unlikely(&tier_ext_attached))
+		__tier_ext_folio_evicted(folio);
+}
+
+#else /* !CONFIG_TIER_EXT */
+
+static inline bool tier_ext_lruvec(struct lruvec *lruvec)
+{
+	return false;
+}
+
+static inline void tier_ext_folio_added(struct lruvec *lruvec,
+					struct folio *folio)
+{
+}
+
+static inline void tier_ext_folio_accessed(struct folio *folio)
+{
+}
+
+static inline void tier_ext_folio_evicted(struct folio *folio)
+{
+}
+
+#endif /* CONFIG_TIER_EXT */
+
+#endif /* _LINUX_TIER_EXT_H */
