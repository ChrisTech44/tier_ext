diff --git a/mm/tier_ext.c b/mm/tier_ext.c
new file mode 100644
index 000000000..2126fe8f1
--- /dev/null
+++ b/mm/tier_ext.c
@@ -0,0 +1,712 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * tier_ext: per-lruvec reclaim policies written in BPF.
+ *
+ * This file owns the BPF struct_ops type "tier_ext_ops":
+ *   - registering a policy binds it to the lruvecs of one memcg on a set of
+ *     nodes (lruvec->tier_ext points at a struct tier_ext_policy);
+ *   - unregistering unbinds it and waits for in-flight callbacks;
+ *   - the __tier_ext_*() functions are called from the reclaim code (vmscan.c,
+ *     folio.c) and translate kernel state into the small context structures
+ *     the BPF programs see, then sanitize whatever the program returns.
+ *
+ * Everything here is written so that a missing, buggy or detached policy
+ * degrades to the kernel's default behaviour.
+ */
+
+#include <linux/bpf.h>
+#include <linux/bpf_verifier.h>
+#include <linux/btf.h>
+#include <linux/btf_ids.h>
+#include <linux/debugfs.h>
+#include <linux/memcontrol.h>
+#include <linux/mm_inline.h>
+#include <linux/nodemask.h>
+#include <linux/percpu.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/tier_ext.h>
+
+#include "internal.h"
+
+DEFINE_STATIC_KEY_FALSE(tier_ext_attached);
+
+/* Per-policy event counters, exported through debugfs. */
+enum tier_ext_stat {
+	TES_SHRINK_CALLS,
+	TES_SHRINK_SKIP,
+	TES_SWAPPINESS_CALLS,
+	TES_SWAPPINESS_SET,
+	TES_SCAN_CALLS,
+	TES_SCAN_RECLAIM,
+	TES_SCAN_KEEP,
+	TES_RECLAIM_CALLS,
+	TES_RECLAIM_RECLAIM,
+	TES_RECLAIM_KEEP,
+	TES_RECLAIM_NO_DEMOTE,
+	TES_RECLAIM_DEMOTE_ONLY,
+	TES_ADDED,
+	TES_ACCESSED,
+	TES_EVICTED,
+	TES_OVERRIDDEN,		/* KEEP/SKIP ignored because priority hit 0 */
+	TES_INVALID,		/* callback returned an unsupported value */
+	NR_TIER_EXT_STATS,
+};
+
+static const char * const tier_ext_stat_names[NR_TIER_EXT_STATS] = {
+	[TES_SHRINK_CALLS]	  = "shrink_calls",
+	[TES_SHRINK_SKIP]	  = "shrink_skip",
+	[TES_SWAPPINESS_CALLS]	  = "swappiness_calls",
+	[TES_SWAPPINESS_SET]	  = "swappiness_set",
+	[TES_SCAN_CALLS]	  = "scan_calls",
+	[TES_SCAN_RECLAIM]	  = "scan_reclaim",
+	[TES_SCAN_KEEP]		  = "scan_keep",
+	[TES_RECLAIM_CALLS]	  = "reclaim_calls",
+	[TES_RECLAIM_RECLAIM]	  = "reclaim_reclaim",
+	[TES_RECLAIM_KEEP]	  = "reclaim_keep",
+	[TES_RECLAIM_NO_DEMOTE]	  = "reclaim_no_demote",
+	[TES_RECLAIM_DEMOTE_ONLY] = "reclaim_demote_only",
+	[TES_ADDED]		  = "folio_added",
+	[TES_ACCESSED]		  = "folio_accessed",
+	[TES_EVICTED]		  = "folio_evicted",
+	[TES_OVERRIDDEN]	  = "overridden",
+	[TES_INVALID]		  = "invalid",
+};
+
+struct tier_ext_stats {
+	u64 cnt[NR_TIER_EXT_STATS];
+};
+
+/*
+ * Kernel-side state of one attached policy. lruvec->tier_ext points here for
+ * every lruvec the policy controls.
+ */
+struct tier_ext_policy {
+	struct tier_ext_ops *ops;	/* the BPF struct_ops instance */
+	struct mem_cgroup *memcg;	/* holds a css reference, NULL if !memcg */
+	u64 cgroup_id;
+	nodemask_t nodes;		/* nodes whose lruvec points here */
+	struct list_head list;		/* on tier_ext_policies */
+	struct tier_ext_stats __percpu *stats;
+};
+
+/* Serializes attach/detach and protects tier_ext_policies. */
+static DEFINE_MUTEX(tier_ext_mutex);
+static LIST_HEAD(tier_ext_policies);
+
+static inline void tes_inc(struct tier_ext_policy *p, enum tier_ext_stat s)
+{
+	this_cpu_inc(p->stats->cnt[s]);
+}
+
+static struct lruvec *tier_ext_node_lruvec(struct mem_cgroup *memcg, int nid)
+{
+	return mem_cgroup_lruvec(memcg, NODE_DATA(nid));
+}
+
+/* ------------------------------------------------------------------------
+ * Hooks called by reclaim
+ * ------------------------------------------------------------------------
+ */
+
+static void tier_ext_fill_folio_ctx(struct tier_ext_folio_ctx *ctx,
+				    struct tier_ext_policy *p,
+				    struct folio *folio,
+				    const struct tier_ext_reclaim *rc)
+{
+	u32 f = 0;
+
+	if (!folio_is_file_lru(folio))
+		f |= TIER_EXT_F_ANON;
+	if (folio_test_active(folio))
+		f |= TIER_EXT_F_ACTIVE;
+	if (folio_test_referenced(folio))
+		f |= TIER_EXT_F_REFERENCED;
+	if (folio_test_workingset(folio))
+		f |= TIER_EXT_F_WORKINGSET;
+	if (folio_test_dirty(folio))
+		f |= TIER_EXT_F_DIRTY;
+	if (folio_test_writeback(folio))
+		f |= TIER_EXT_F_WRITEBACK;
+	if (folio_mapped(folio))
+		f |= TIER_EXT_F_MAPPED;
+	if (folio_test_swapcache(folio))
+		f |= TIER_EXT_F_SWAPCACHE;
+	if (folio_test_unevictable(folio))
+		f |= TIER_EXT_F_UNEVICTABLE;
+	if (folio_test_large(folio))
+		f |= TIER_EXT_F_LARGE;
+
+	ctx->folio = folio;
+	ctx->cgroup_id = p->cgroup_id;
+	ctx->pfn = folio_pfn(folio);
+	ctx->nid = folio_nid(folio);
+	ctx->nr_pages = folio_nr_pages(folio);
+	ctx->folio_flags = f;
+#ifdef CONFIG_LRU_GEN
+	ctx->lru_gen = folio_lru_gen(folio);
+	ctx->lru_refs = ctx->lru_gen >= 0 ? folio_lru_refs(folio) : 0;
+#else
+	ctx->lru_gen = -1;
+	ctx->lru_refs = 0;
+#endif
+	ctx->lru = -1;
+	ctx->referenced_ptes = 0;
+	if (rc) {
+		ctx->engine = rc->engine;
+		ctx->priority = rc->priority;
+		ctx->reclaim_flags = rc->flags;
+	} else {
+		ctx->engine = lru_gen_enabled() ? TIER_EXT_ENGINE_MGLRU :
+						  TIER_EXT_ENGINE_CLASSIC;
+		ctx->priority = -1;
+		ctx->reclaim_flags = 0;
+	}
+}
+
+static void tier_ext_fill_lruvec_ctx(struct tier_ext_lruvec_ctx *ctx,
+				     struct tier_ext_policy *p,
+				     struct lruvec *lruvec,
+				     const struct tier_ext_reclaim *rc,
+				     int swappiness)
+{
+	ctx->cgroup_id = p->cgroup_id;
+	ctx->nid = lruvec_pgdat(lruvec)->node_id;
+	ctx->engine = rc->engine;
+	ctx->priority = rc->priority;
+	ctx->swappiness = swappiness;
+	ctx->reclaim_flags = rc->flags;
+	ctx->__pad = 0;
+	ctx->nr_to_reclaim = rc->nr_to_reclaim;
+	ctx->nr_reclaimed = rc->nr_reclaimed;
+	ctx->nr_anon = lruvec_page_state(lruvec, NR_INACTIVE_ANON) +
+		       lruvec_page_state(lruvec, NR_ACTIVE_ANON);
+	ctx->nr_file = lruvec_page_state(lruvec, NR_INACTIVE_FILE) +
+		       lruvec_page_state(lruvec, NR_ACTIVE_FILE);
+}
+
+/*
+ * Returns true if the policy asked to skip @lruvec for this reclaim pass.
+ * The request is ignored once reclaim reaches priority 0, so a policy can
+ * delay reclaim but never make it impossible.
+ */
+bool __tier_ext_lruvec_skip(struct lruvec *lruvec,
+			    const struct tier_ext_reclaim *rc)
+{
+	struct tier_ext_lruvec_ctx ctx;
+	struct tier_ext_policy *p;
+	bool skip = false;
+	int ret;
+
+	rcu_read_lock();
+	p = rcu_dereference(lruvec->tier_ext);
+	if (!p || !p->ops->lruvec_shrink)
+		goto out;
+
+	tier_ext_fill_lruvec_ctx(&ctx, p, lruvec, rc, -1);
+	tes_inc(p, TES_SHRINK_CALLS);
+	ret = p->ops->lruvec_shrink(&ctx);
+	if (ret == TIER_EXT_SKIP) {
+		if (rc->priority > 0) {
+			tes_inc(p, TES_SHRINK_SKIP);
+			skip = true;
+		} else {
+			tes_inc(p, TES_OVERRIDDEN);
+		}
+	} else if (ret != TIER_EXT_DEFAULT) {
+		tes_inc(p, TES_INVALID);
+	}
+out:
+	rcu_read_unlock();
+	return skip;
+}
+
+/* Returns the swappiness to use for @lruvec; @swappiness is the default. */
+int __tier_ext_swappiness(struct lruvec *lruvec,
+			  const struct tier_ext_reclaim *rc, int swappiness)
+{
+	struct tier_ext_lruvec_ctx ctx;
+	struct tier_ext_policy *p;
+	int ret;
+
+	rcu_read_lock();
+	p = rcu_dereference(lruvec->tier_ext);
+	if (!p || !p->ops->swappiness)
+		goto out;
+
+	tier_ext_fill_lruvec_ctx(&ctx, p, lruvec, rc, swappiness);
+	tes_inc(p, TES_SWAPPINESS_CALLS);
+	ret = p->ops->swappiness(&ctx);
+	if (ret >= MIN_SWAPPINESS && ret <= MAX_SWAPPINESS) {
+		tes_inc(p, TES_SWAPPINESS_SET);
+		swappiness = ret;
+	} else if (ret >= 0) {
+		tes_inc(p, TES_INVALID);
+	}
+out:
+	rcu_read_unlock();
+	return swappiness;
+}
+
+/*
+ * Called with the LRU lock held while the scanner looks at the folio at the
+ * cold end of @lruvec. Returns TIER_EXT_{DEFAULT,RECLAIM,KEEP}.
+ */
+int __tier_ext_folio_scan(struct lruvec *lruvec, struct folio *folio,
+			  const struct tier_ext_reclaim *rc, int lru)
+{
+	struct tier_ext_folio_ctx ctx;
+	struct tier_ext_policy *p;
+	int ret = TIER_EXT_DEFAULT;
+
+	rcu_read_lock();
+	p = rcu_dereference(lruvec->tier_ext);
+	if (!p || !p->ops->folio_scan)
+		goto out;
+
+	tier_ext_fill_folio_ctx(&ctx, p, folio, rc);
+	ctx.lru = lru;
+	tes_inc(p, TES_SCAN_CALLS);
+	ret = p->ops->folio_scan(&ctx);
+	switch (ret) {
+	case TIER_EXT_DEFAULT:
+		break;
+	case TIER_EXT_RECLAIM:
+		tes_inc(p, TES_SCAN_RECLAIM);
+		break;
+	case TIER_EXT_KEEP:
+		if (rc->priority > 0) {
+			tes_inc(p, TES_SCAN_KEEP);
+		} else {
+			tes_inc(p, TES_OVERRIDDEN);
+			ret = TIER_EXT_DEFAULT;
+		}
+		break;
+	default:
+		tes_inc(p, TES_INVALID);
+		ret = TIER_EXT_DEFAULT;
+	}
+out:
+	rcu_read_unlock();
+	return ret;
+}
+
+/*
+ * Called from shrink_folio_list() for an isolated, locked folio right after
+ * its references were counted. Returns a verdict possibly OR-ed with
+ * TIER_EXT_NO_DEMOTE or TIER_EXT_DEMOTE_ONLY.
+ */
+unsigned int __tier_ext_folio_reclaim(struct lruvec *lruvec,
+				      struct folio *folio,
+				      const struct tier_ext_reclaim *rc,
+				      int referenced_ptes)
+{
+	struct tier_ext_folio_ctx ctx;
+	struct tier_ext_policy *p;
+	unsigned int ret = TIER_EXT_DEFAULT, verdict, flags;
+
+	rcu_read_lock();
+	p = rcu_dereference(lruvec->tier_ext);
+	if (!p || !p->ops->folio_reclaim)
+		goto out;
+
+	tier_ext_fill_folio_ctx(&ctx, p, folio, rc);
+	ctx.referenced_ptes = referenced_ptes;
+	tes_inc(p, TES_RECLAIM_CALLS);
+	ret = (u32)p->ops->folio_reclaim(&ctx);
+
+	verdict = ret & TIER_EXT_VERDICT_MASK;
+	flags = ret & ~TIER_EXT_VERDICT_MASK;
+	if (verdict > TIER_EXT_KEEP ||
+	    (flags & ~(TIER_EXT_NO_DEMOTE | TIER_EXT_DEMOTE_ONLY)) ||
+	    flags == (TIER_EXT_NO_DEMOTE | TIER_EXT_DEMOTE_ONLY)) {
+		tes_inc(p, TES_INVALID);
+		ret = TIER_EXT_DEFAULT;
+		goto out;
+	}
+
+	if (verdict == TIER_EXT_KEEP) {
+		if (rc->priority > 0) {
+			tes_inc(p, TES_RECLAIM_KEEP);
+			ret = TIER_EXT_KEEP;
+			goto out;
+		}
+		/* too desperate to honour KEEP, and flags make no sense on it */
+		tes_inc(p, TES_OVERRIDDEN);
+		ret = TIER_EXT_DEFAULT;
+		goto out;
+	}
+
+	if (verdict == TIER_EXT_RECLAIM)
+		tes_inc(p, TES_RECLAIM_RECLAIM);
+	if (flags & TIER_EXT_NO_DEMOTE)
+		tes_inc(p, TES_RECLAIM_NO_DEMOTE);
+	if (flags & TIER_EXT_DEMOTE_ONLY) {
+		if (rc->priority > 0) {
+			tes_inc(p, TES_RECLAIM_DEMOTE_ONLY);
+		} else {
+			tes_inc(p, TES_OVERRIDDEN);
+			ret &= ~TIER_EXT_DEMOTE_ONLY;
+		}
+	}
+out:
+	rcu_read_unlock();
+	return ret;
+}
+
+void __tier_ext_folio_added(struct lruvec *lruvec, struct folio *folio)
+{
+	struct tier_ext_folio_ctx ctx;
+	struct tier_ext_policy *p;
+
+	rcu_read_lock();
+	p = rcu_dereference(lruvec->tier_ext);
+	if (p && p->ops->folio_added) {
+		tier_ext_fill_folio_ctx(&ctx, p, folio, NULL);
+		tes_inc(p, TES_ADDED);
+		p->ops->folio_added(&ctx);
+	}
+	rcu_read_unlock();
+}
+
+/* Must be called under rcu_read_lock(). */
+static struct tier_ext_policy *tier_ext_folio_policy(struct folio *folio)
+{
+	struct mem_cgroup *memcg = folio_memcg(folio);
+
+	if (!memcg && !mem_cgroup_disabled())
+		return NULL;
+	return rcu_dereference(mem_cgroup_lruvec(memcg, folio_pgdat(folio))->tier_ext);
+}
+
+void __tier_ext_folio_accessed(struct folio *folio)
+{
+	struct tier_ext_folio_ctx ctx;
+	struct tier_ext_policy *p;
+
+	rcu_read_lock();
+	p = tier_ext_folio_policy(folio);
+	if (p && p->ops->folio_accessed) {
+		tier_ext_fill_folio_ctx(&ctx, p, folio, NULL);
+		tes_inc(p, TES_ACCESSED);
+		p->ops->folio_accessed(&ctx);
+	}
+	rcu_read_unlock();
+}
+
+void __tier_ext_folio_evicted(struct folio *folio)
+{
+	struct tier_ext_folio_ctx ctx;
+	struct tier_ext_policy *p;
+
+	rcu_read_lock();
+	p = tier_ext_folio_policy(folio);
+	if (p && p->ops->folio_evicted) {
+		tier_ext_fill_folio_ctx(&ctx, p, folio, NULL);
+		tes_inc(p, TES_EVICTED);
+		p->ops->folio_evicted(&ctx);
+	}
+	rcu_read_unlock();
+}
+
+/* ------------------------------------------------------------------------
+ * Attach / detach
+ * ------------------------------------------------------------------------
+ */
+
+static void tier_ext_policy_free(struct tier_ext_policy *p)
+{
+	if (p->memcg)
+		mem_cgroup_put(p->memcg);
+	free_percpu(p->stats);
+	kfree(p);
+}
+
+static int tier_ext_attach(struct tier_ext_ops *ops)
+{
+	struct tier_ext_policy *p, *pos;
+	struct mem_cgroup *memcg = NULL;
+	nodemask_t nodes = NODE_MASK_NONE;
+	u64 cgroup_id = ops->cgroup_id;
+	int nid, err;
+
+	/* Resolve the node mask: 0 means every possible node. */
+	if (!ops->node_mask) {
+		nodes = node_possible_map;
+	} else {
+		for (nid = 0; nid < 64; nid++) {
+			if (!(ops->node_mask & BIT_ULL(nid)))
+				continue;
+			if (nid >= MAX_NUMNODES || !node_possible(nid))
+				return -EINVAL;
+			node_set(nid, nodes);
+		}
+	}
+
+	/* Resolve the memcg; cgroup id 0 means the root cgroup. */
+	if (mem_cgroup_disabled()) {
+		if (cgroup_id)
+			return -EOPNOTSUPP;
+	} else if (!cgroup_id) {
+		memcg = root_mem_cgroup;
+		css_get(&memcg->css);
+		cgroup_id = mem_cgroup_id(memcg);
+	} else {
+		memcg = mem_cgroup_get_from_id(cgroup_id);
+		if (!memcg)
+			return -ENOENT;
+		/*
+		 * mem_cgroup_get_from_id() returns the closest ancestor with the
+		 * memory controller enabled. A policy must name the exact memcg.
+		 */
+		if (mem_cgroup_id(memcg) != cgroup_id) {
+			mem_cgroup_put(memcg);
+			return -EINVAL;
+		}
+	}
+
+	p = kzalloc(sizeof(*p), GFP_KERNEL);
+	if (!p) {
+		err = -ENOMEM;
+		goto err_put;
+	}
+	p->stats = alloc_percpu(struct tier_ext_stats);
+	if (!p->stats) {
+		kfree(p);
+		err = -ENOMEM;
+		goto err_put;
+	}
+	p->ops = ops;
+	p->memcg = memcg;
+	p->cgroup_id = cgroup_id;
+	p->nodes = nodes;
+
+	mutex_lock(&tier_ext_mutex);
+
+	list_for_each_entry(pos, &tier_ext_policies, list) {
+		if (pos->ops == ops) {
+			err = -EEXIST;
+			goto err_unlock;
+		}
+	}
+
+	/* One policy per lruvec. */
+	for_each_node_mask(nid, nodes) {
+		if (rcu_access_pointer(tier_ext_node_lruvec(memcg, nid)->tier_ext)) {
+			err = -EBUSY;
+			goto err_unlock;
+		}
+	}
+
+	static_branch_inc(&tier_ext_attached);
+	for_each_node_mask(nid, nodes)
+		rcu_assign_pointer(tier_ext_node_lruvec(memcg, nid)->tier_ext, p);
+	list_add_tail(&p->list, &tier_ext_policies);
+
+	mutex_unlock(&tier_ext_mutex);
+
+	pr_info("tier_ext: attached policy '%s' to cgroup %llu nodes %*pbl\n",
+		ops->name, cgroup_id, nodemask_pr_args(&nodes));
+	return 0;
+
+err_unlock:
+	mutex_unlock(&tier_ext_mutex);
+	p->memcg = NULL;
+	tier_ext_policy_free(p);
+err_put:
+	if (memcg)
+		mem_cgroup_put(memcg);
+	return err;
+}
+
+static void tier_ext_detach(struct tier_ext_ops *ops)
+{
+	struct tier_ext_policy *p = NULL, *pos;
+	int nid;
+
+	mutex_lock(&tier_ext_mutex);
+	list_for_each_entry(pos, &tier_ext_policies, list) {
+		if (pos->ops == ops) {
+			p = pos;
+			break;
+		}
+	}
+	if (!p) {
+		mutex_unlock(&tier_ext_mutex);
+		return;
+	}
+
+	for_each_node_mask(nid, p->nodes)
+		RCU_INIT_POINTER(tier_ext_node_lruvec(p->memcg, nid)->tier_ext, NULL);
+	list_del(&p->list);
+	mutex_unlock(&tier_ext_mutex);
+
+	/* Every callback runs inside an RCU read-side section. */
+	synchronize_rcu();
+	static_branch_dec(&tier_ext_attached);
+
+	pr_info("tier_ext: detached policy '%s' from cgroup %llu\n",
+		ops->name, p->cgroup_id);
+	tier_ext_policy_free(p);
+}
+
+/* ------------------------------------------------------------------------
+ * BPF struct_ops glue
+ * ------------------------------------------------------------------------
+ */
+
+static int tier_ext_ops_reg(void *kdata, struct bpf_link *link)
+{
+	return tier_ext_attach(kdata);
+}
+
+static void tier_ext_ops_unreg(void *kdata, struct bpf_link *link)
+{
+	tier_ext_detach(kdata);
+}
+
+static int tier_ext_ops_init(struct btf *btf)
+{
+	/* Make the uapi-ish enums visible in vmlinux BTF for BPF programs. */
+	BTF_TYPE_EMIT_ENUM(TIER_EXT_DEFAULT);
+	BTF_TYPE_EMIT_ENUM(TIER_EXT_NO_DEMOTE);
+	BTF_TYPE_EMIT_ENUM(TIER_EXT_ENGINE_CLASSIC);
+	BTF_TYPE_EMIT_ENUM(TIER_EXT_RC_KSWAPD);
+	BTF_TYPE_EMIT_ENUM(TIER_EXT_F_ANON);
+	return 0;
+}
+
+static int tier_ext_ops_init_member(const struct btf_type *t,
+				    const struct btf_member *member,
+				    void *kdata, const void *udata)
+{
+	const struct tier_ext_ops *uops = udata;
+	struct tier_ext_ops *ops = kdata;
+	u32 moff = __btf_member_bit_offset(t, member) / 8;
+
+	switch (moff) {
+	case offsetof(struct tier_ext_ops, cgroup_id):
+		ops->cgroup_id = uops->cgroup_id;
+		return 1;
+	case offsetof(struct tier_ext_ops, node_mask):
+		ops->node_mask = uops->node_mask;
+		return 1;
+	case offsetof(struct tier_ext_ops, flags):
+		if (uops->flags)
+			return -EINVAL;
+		ops->flags = uops->flags;
+		return 1;
+	case offsetof(struct tier_ext_ops, name):
+		if (bpf_obj_name_cpy(ops->name, uops->name,
+				     sizeof(ops->name)) <= 0)
+			return -EINVAL;
+		return 1;
+	}
+	return 0;
+}
+
+static int tier_ext_ops_check_member(const struct btf_type *t,
+				     const struct btf_member *member,
+				     const struct bpf_prog *prog)
+{
+	/* Every callback runs in atomic context. */
+	if (prog->sleepable)
+		return -EINVAL;
+	return 0;
+}
+
+static bool tier_ext_ops_is_valid_access(int off, int size,
+					 enum bpf_access_type type,
+					 const struct bpf_prog *prog,
+					 struct bpf_insn_access_aux *info)
+{
+	return bpf_tracing_btf_ctx_access(off, size, type, prog, info);
+}
+
+static int tier_ext_ops_btf_struct_access(struct bpf_verifier_log *log,
+					  const struct bpf_reg_state *reg,
+					  int off, int size)
+{
+	/* Policies observe kernel state; they never write it directly. */
+	return -EACCES;
+}
+
+static const struct bpf_verifier_ops tier_ext_verifier_ops = {
+	.get_func_proto		= bpf_base_func_proto,
+	.is_valid_access	= tier_ext_ops_is_valid_access,
+	.btf_struct_access	= tier_ext_ops_btf_struct_access,
+};
+
+/* CFI stubs: the signatures every BPF callback must match. */
+static s32 tier_ext_stub_lruvec(struct tier_ext_lruvec_ctx *ctx) { return 0; }
+static s32 tier_ext_stub_folio(struct tier_ext_folio_ctx *ctx) { return 0; }
+static void tier_ext_stub_event(struct tier_ext_folio_ctx *ctx) {}
+
+static struct tier_ext_ops __bpf_ops_tier_ext_ops = {
+	.lruvec_shrink	= tier_ext_stub_lruvec,
+	.swappiness	= tier_ext_stub_lruvec,
+	.folio_scan	= tier_ext_stub_folio,
+	.folio_reclaim	= tier_ext_stub_folio,
+	.folio_added	= tier_ext_stub_event,
+	.folio_accessed	= tier_ext_stub_event,
+	.folio_evicted	= tier_ext_stub_event,
+};
+
+static struct bpf_struct_ops bpf_tier_ext_ops = {
+	.verifier_ops	= &tier_ext_verifier_ops,
+	.init		= tier_ext_ops_init,
+	.check_member	= tier_ext_ops_check_member,
+	.init_member	= tier_ext_ops_init_member,
+	.reg		= tier_ext_ops_reg,
+	.unreg		= tier_ext_ops_unreg,
+	.name		= "tier_ext_ops",
+	.cfi_stubs	= &__bpf_ops_tier_ext_ops,
+	.owner		= THIS_MODULE,
+};
+
+/* ------------------------------------------------------------------------
+ * debugfs: /sys/kernel/debug/tier_ext
+ * ------------------------------------------------------------------------
+ */
+
+static int tier_ext_debugfs_show(struct seq_file *m, void *v)
+{
+	struct tier_ext_policy *p;
+	int cpu, i;
+
+	mutex_lock(&tier_ext_mutex);
+	list_for_each_entry(p, &tier_ext_policies, list) {
+		u64 sum[NR_TIER_EXT_STATS] = {};
+
+		for_each_possible_cpu(cpu) {
+			struct tier_ext_stats *s = per_cpu_ptr(p->stats, cpu);
+
+			for (i = 0; i < NR_TIER_EXT_STATS; i++)
+				sum[i] += READ_ONCE(s->cnt[i]);
+		}
+
+		seq_printf(m, "policy %s cgroup %llu nodes %*pbl\n",
+			   p->ops->name, p->cgroup_id,
+			   nodemask_pr_args(&p->nodes));
+		for (i = 0; i < NR_TIER_EXT_STATS; i++)
+			seq_printf(m, "  %s %llu\n", tier_ext_stat_names[i], sum[i]);
+	}
+	mutex_unlock(&tier_ext_mutex);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(tier_ext_debugfs);
+
+static int __init tier_ext_init(void)
+{
+	int err;
+
+	err = register_bpf_struct_ops(&bpf_tier_ext_ops, tier_ext_ops);
+	if (err) {
+		pr_warn("tier_ext: failed to register struct_ops: %d\n", err);
+		return err;
+	}
+
+	debugfs_create_file("tier_ext", 0400, NULL, NULL, &tier_ext_debugfs_fops);
+	return 0;
+}
+late_initcall(tier_ext_init);
