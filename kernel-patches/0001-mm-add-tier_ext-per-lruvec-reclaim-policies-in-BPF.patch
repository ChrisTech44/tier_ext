+#ifdef CONFIG_TIER_EXT
+/*
+ * tier_ext hooks: consult the BPF policy attached to an lruvec, if any. Each
+ * helper is a no-op returning the default unless a policy is attached.
+ */
+static void tier_ext_rc(struct tier_ext_reclaim *rc, struct scan_control *sc,
+			int engine)
+{
+	rc->engine = engine;
+	rc->priority = sc->priority;
+	rc->flags = (current_is_kswapd() ? TIER_EXT_RC_KSWAPD : 0) |
+		    (sc->proactive ? TIER_EXT_RC_PROACTIVE : 0) |
+		    (cgroup_reclaim(sc) ? TIER_EXT_RC_CGROUP : 0);
+	rc->nr_to_reclaim = sc->nr_to_reclaim;
+	rc->nr_reclaimed = sc->nr_reclaimed;
+}
+
+static bool tier_ext_skip_lruvec(struct lruvec *lruvec, struct scan_control *sc,
+				 int engine)
+{
+	struct tier_ext_reclaim rc;
+
+	if (!tier_ext_lruvec(lruvec))
+		return false;
+	tier_ext_rc(&rc, sc, engine);
+	return __tier_ext_lruvec_skip(lruvec, &rc);
+}
+
+static int tier_ext_swappiness(struct lruvec *lruvec, struct scan_control *sc,
+			       int engine, int swappiness)
+{
+	struct tier_ext_reclaim rc;
+
+	if (!tier_ext_lruvec(lruvec) || swappiness == SWAPPINESS_ANON_ONLY)
+		return swappiness;
+	tier_ext_rc(&rc, sc, engine);
+	return __tier_ext_swappiness(lruvec, &rc, swappiness);
+}
+
+/* Called with the LRU lock held; @folio is on an LRU list of @lruvec. */
+static int tier_ext_scan(struct lruvec *lruvec, struct folio *folio,
+			 struct scan_control *sc, int engine, int lru)
+{
+	struct tier_ext_reclaim rc;
+
+	if (!tier_ext_lruvec(lruvec))
+		return TIER_EXT_DEFAULT;
+	tier_ext_rc(&rc, sc, engine);
+	return __tier_ext_folio_scan(lruvec, folio, &rc, lru);
+}
+
+/* @folio is isolated and locked, so its memcg binding is stable. */
+static unsigned int tier_ext_reclaim_verdict(struct folio *folio,
+					     struct scan_control *sc,
+					     int engine, int referenced_ptes)
+{
+	struct tier_ext_reclaim rc;
+	struct lruvec *lruvec;
+
+	if (!static_branch_unlikely(&tier_ext_attached))
+		return TIER_EXT_DEFAULT;
+	lruvec = folio_lruvec(folio);
+	if (!tier_ext_lruvec(lruvec))
+		return TIER_EXT_DEFAULT;
+	tier_ext_rc(&rc, sc, engine);
+	return __tier_ext_folio_reclaim(lruvec, folio, &rc, referenced_ptes);
+}
+#else
+static inline bool tier_ext_skip_lruvec(struct lruvec *lruvec,
+					struct scan_control *sc, int engine)
+{
+	return false;
+}
+
+static inline int tier_ext_swappiness(struct lruvec *lruvec,
+				      struct scan_control *sc, int engine,
+				      int swappiness)
+{
+	return swappiness;
