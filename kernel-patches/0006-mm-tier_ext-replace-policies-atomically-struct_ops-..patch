@@ -898,6 +918,41 @@ static void tier_ext_ops_unreg(void *kdata, struct bpf_link *link)
 	tier_ext_detach(kdata);
 }
 
+/*
+ * Replace an attached policy's programs atomically (BPF_LINK_UPDATE): the
+ * lruvecs never run without a policy in between. The new ops must name the
+ * same target; retargeting is a detach and an attach. The new policy starts
+ * without the old one's state (its maps are its own).
+ */
+static int tier_ext_ops_update(void *kdata, void *old_kdata,
+			       struct bpf_link *link)
+{
+	struct tier_ext_ops *ops = kdata, *old = old_kdata;
+	struct tier_ext_policy *p;
+	int err = -ENOENT;
+
+	if (ops->cgroup_id != old->cgroup_id || ops->node_mask != old->node_mask)
+		return -EINVAL;
+
+	mutex_lock(&tier_ext_mutex);
+	list_for_each_entry(p, &tier_ext_policies, list) {
+		if (p->ops != old)
+			continue;
+		WRITE_ONCE(p->ops, ops);
+		err = 0;
+		break;
+	}
+	mutex_unlock(&tier_ext_mutex);
+	if (err)
+		return err;
+
+	/* no callback of the old programs is still running afterwards */
+	synchronize_rcu();
+	pr_info("tier_ext: replaced policy '%s' with '%s' (cgroup %llu)\n",
+		old->name, ops->name, p->cgroup_id);
+	return 0;
+}
+
 static int tier_ext_ops_init(struct btf *btf)
 {
 	/* Make the uapi-ish enums visible in vmlinux BTF for BPF programs. */
@@ -1057,6 +1112,7 @@ static struct bpf_struct_ops bpf_tier_ext_ops = {
 	.init_member	= tier_ext_ops_init_member,
 	.reg		= tier_ext_ops_reg,
 	.unreg		= tier_ext_ops_unreg,
+	.update		= tier_ext_ops_update,
 	.name		= "tier_ext_ops",
 	.cfi_stubs	= &__bpf_ops_tier_ext_ops,
 	.owner		= THIS_MODULE,
@@ -1084,7 +1140,7 @@ static int tier_ext_debugfs_show(struct seq_file *m, void *v)
 		}
 
 		seq_printf(m, "policy %s cgroup %llu nodes %*pbl\n",
-			   p->ops->name, p->cgroup_id,
+			   READ_ONCE(p->ops)->name, p->cgroup_id,
 			   nodemask_pr_args(&p->nodes));
 		for (i = 0; i < NR_TIER_EXT_STATS; i++)
 			seq_printf(m, "  %s %llu\n", tier_ext_stat_names[i], sum[i]);
