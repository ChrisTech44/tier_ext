diff --git a/include/linux/tier_ext.h b/include/linux/tier_ext.h
index cafd5cbb3..cd2721f48 100644
--- a/include/linux/tier_ext.h
+++ b/include/linux/tier_ext.h
@@ -59,6 +59,8 @@ enum tier_ext_reclaim_flags {
 	TIER_EXT_RC_KSWAPD	= 1U << 0,	/* background reclaim by kswapd */
 	TIER_EXT_RC_PROACTIVE	= 1U << 1,	/* memory.reclaim / node reclaim */
 	TIER_EXT_RC_CGROUP	= 1U << 2,	/* reclaim targets a memcg (limit hit) */
+	/* folio_reclaim: the folio was nominated by this policy's pick_victims */
+	TIER_EXT_RC_NOMINATED	= 1U << 3,
 };
 
 /* tier_ext_folio_ctx::folio_flags, a snapshot of the folio's state. */
@@ -73,6 +75,37 @@ enum tier_ext_folio_flags {
 	TIER_EXT_F_SWAPCACHE	= 1U << 7,
 	TIER_EXT_F_UNEVICTABLE	= 1U << 8,
 	TIER_EXT_F_LARGE	= 1U << 9,	/* more than one page */
+	/*
+	 * folio_added only: the folio was nominated by pick_victims, was not
+	 * reclaimed, and is being handed back to the policy (see D21).
+	 */
+	TIER_EXT_F_RETURNED	= 1U << 10,
+	/* folio_added only: the folio was split off a large folio */
+	TIER_EXT_F_SPLIT	= 1U << 11,
+};
+
+/* tier_ext_folio_ctx::data_key: bit 63 set means "swap slot" */
+#define TIER_EXT_KEY_SWAP	(1ULL << 63)
+
+/* Victim nomination: at most this many folios per pick_victims call. */
+#define TIER_EXT_MAX_VICTIMS	32
+
+/* tier_ext_victims_ctx::flags: what the kernel accepts in this batch. */
+enum tier_ext_victims_flags {
+	TIER_EXT_VF_MAY_ANON	= 1U << 0,	/* anon folios can be reclaimed */
+	TIER_EXT_VF_MAY_FILE	= 1U << 1,	/* file folios can be reclaimed */
+	TIER_EXT_VF_MAY_UNMAP	= 1U << 2,	/* mapped folios can be reclaimed */
+	TIER_EXT_VF_CAN_AGE	= 1U << 3,	/* TIER_EXT_AGE is honoured */
+};
+
+/* Flags pick_victims may return. */
+enum tier_ext_victims_ret {
+	/*
+	 * Run the engine's aging for this lruvec after this batch (MGLRU:
+	 * a page table walk, which reports young folios via
+	 * folio_referenced). At most once per lruvec per reclaim pass.
+	 */
+	TIER_EXT_AGE		= 1U << 0,
 };
 
 /* Passed to the per-lruvec callbacks (lruvec_shrink, swappiness). */
@@ -105,6 +138,44 @@ struct tier_ext_folio_ctx {
 	s32 referenced_ptes;	/* folio_reclaim: young PTEs found by rmap */
 	s32 priority;		/* reclaim priority, -1 outside of reclaim */
 	u32 reclaim_flags;	/* enum tier_ext_reclaim_flags, 0 outside reclaim */
+	/*
+	 * Identity of the data the folio holds, independent of the page frame:
+	 * the same value comes back when the same file offset or swap slot is
+	 * read in again after eviction (see D23). Page cache: hash of
+	 * (device, inode) in the upper 32 bits, file index in the lower ones.
+	 * Swap cache: TIER_EXT_KEY_SWAP | swap entry. 0 if unknown.
+	 */
+	u64 data_key;
+	u64 old_pfn;		/* folio_migrated: pfn before migration */
+	s32 old_nid;		/* folio_migrated: node before migration */
+	u32 __pad;
+};
+
+/*
+ * Passed to pick_victims. Everything is read-only except the output, which
+ * the policy fills with bpf_tier_ext_add_victim().
+ */
+struct tier_ext_victims_ctx {
+	u64 cgroup_id;
+	s32 nid;
+	s32 engine;
+	s32 priority;
+	s32 swappiness;		/* effective swappiness, 201 = anon only */
+	u32 reclaim_flags;	/* enum tier_ext_reclaim_flags */
+	u32 flags;		/* enum tier_ext_victims_flags */
+	u32 nr_requested;	/* pages the kernel would like from this batch */
+	u32 batch;		/* 0 for the first call of this reclaim pass */
+	u64 nr_to_reclaim;	/* pages the whole reclaim pass is trying to free */
+	u64 nr_reclaimed;	/* pages freed so far by this reclaim pass */
+	u64 nr_anon;		/* anon pages on this lruvec's LRU lists */
+	u64 nr_file;		/* file pages on this lruvec's LRU lists */
+	/* the kernel's own anon/file split of this pass's scan budget */
+	u64 nr_scan_anon;
+	u64 nr_scan_file;
+	/* output */
+	u32 nr;			/* entries used in pfns[] */
+	u32 __pad;
+	u64 pfns[TIER_EXT_MAX_VICTIMS];
 };
 
 /**
@@ -137,6 +208,23 @@ struct tier_ext_folio_ctx {
  *	through @folio_reclaim and the MGLRU generation.
  * @folio_evicted: Reclaim freed the folio (it is leaving memory). Demoted
