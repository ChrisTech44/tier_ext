+/*
+ * Victim nomination (see D19 in the tier_ext design): the policy of @lruvec
+ * chooses what to reclaim first. @budget is how many pages the engine planned
+ * to scan in this lruvec in this pass; the policy's victims are taken out of
+ * it, in batches of up to TIER_EXT_MAX_VICTIMS folios, until the budget or
+ * the reclaim target is reached or the policy has nothing (valid) left.
+ * @age, if not NULL, runs the engine's aging (TIER_EXT_AGE).
+ *
+ * Returns the pages reclaimed. The caller adds them to sc->nr_reclaimed.
+ * @nr_taken returns the pages isolated per type ([0] anon, [1] file); the
+ * caller takes them out of the default engine's scan budget.
+ */
+static unsigned long tier_ext_reclaim_victims(struct lruvec *lruvec,
+		struct scan_control *sc, int engine, int swappiness,
+		unsigned long budget, unsigned long scan_anon,
+		unsigned long scan_file,
+		bool (*age)(struct lruvec *, struct scan_control *, int),
+		unsigned long *nr_taken)
+{
+	struct pglist_data *pgdat = lruvec_pgdat(lruvec);
+	struct mem_cgroup *memcg = lruvec_memcg(lruvec);
