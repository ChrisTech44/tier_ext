+			stolen_file = min(v.nr_taken[1] - min(kept[1], v.nr_taken[1]),
+					  (unsigned long)reclaimed);
+			mod_lruvec_state(lruvec, PGSTEAL_FILE, stolen_file);
+			mod_lruvec_state(lruvec, PGSTEAL_ANON, reclaimed - stolen_file);
+			handle_reclaim_writeback(taken, pgdat, sc, &stat);
