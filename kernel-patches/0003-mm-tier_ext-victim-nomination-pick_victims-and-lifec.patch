@@ -206,10 +362,11 @@ static __always_inline void tier_ext_folio_accessed(struct folio *folio)
 		__tier_ext_folio_accessed(folio);
 }
 
-static __always_inline void tier_ext_folio_evicted(struct folio *folio)
+static __always_inline void tier_ext_folio_evicted(struct folio *folio,
