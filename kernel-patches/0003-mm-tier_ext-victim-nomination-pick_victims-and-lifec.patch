+/*
+ * Identity of the data in @folio, independent of the page frame, so that a
+ * policy can recognise data that comes back after eviction (ghost entries,
+ * refault detection). See D23. Racy by nature: the result is a hint.
+ * Callers hold rcu_read_lock() or the folio lock (inodes are RCU-freed).
+ */
+u64 tier_ext_data_key(struct folio *folio)
+{
+	struct address_space *mapping;
+	struct inode *host;
+	u64 id;
+
+	if (folio_test_swapcache(folio))
+		return TIER_EXT_KEY_SWAP | folio->swap.val;
+
+	mapping = READ_ONCE(folio->mapping);
+	if (!mapping || ((unsigned long)mapping & FOLIO_MAPPING_FLAGS))
+		return 0;
+	host = READ_ONCE(mapping->host);
+	if (!host)
+		return 0;
+	id = hash_64(host->i_ino ^ ((u64)host->i_sb->s_dev << 32), 31);
+	return (id << 32) | (u32)folio->index;
+}
+
 static void tier_ext_fill_folio_ctx(struct tier_ext_folio_ctx *ctx,
 				    struct tier_ext_policy *p,
 				    struct folio *folio,
@@ -159,6 +215,10 @@ static void tier_ext_fill_folio_ctx(struct tier_ext_folio_ctx *ctx,
 #endif
 	ctx->lru = -1;
 	ctx->referenced_ptes = 0;
+	ctx->data_key = tier_ext_data_key(folio);
+	ctx->old_pfn = 0;
+	ctx->old_nid = NUMA_NO_NODE;
