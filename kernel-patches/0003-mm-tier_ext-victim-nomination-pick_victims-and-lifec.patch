+
+/*
+ * Turn one nominated pfn into an isolated folio of @lruvec, or explain why
+ * not. Nothing about @pfn is trusted: it may be garbage, a free page, a tail
+ * page, a kernel page or another cgroup's folio. Only a head page we can
+ * take a reference on, that is on @lruvec's LRU, is isolated.
+ *
+ * Called under rcu_read_lock() with interrupts enabled (folio_isolate_lru()
+ * takes the LRU lock itself).
+ */
+static enum tier_ext_stat tier_ext_isolate_victim(struct tier_ext_policy *p,
+						  struct lruvec *lruvec,
+						  u64 pfn,
+						  const struct tier_ext_reclaim *rc,
+						  struct tier_ext_victims *v)
+{
+	enum tier_ext_stat res;
+	struct folio *folio;
+	struct page *page;
+	bool file;
+
+	if (pfn != (unsigned long)pfn)
+		return TES_VICTIM_INVALID;
+	page = pfn_to_online_page(pfn);
+	if (!page)
+		return TES_VICTIM_INVALID;
+	/* fails for free pages and tail pages; a head page stays a head */
+	folio = folio_get_nontail_page(page);
+	if (!folio)
+		return TES_VICTIM_INVALID;
+
+	/*
+	 * Only LRU folios are known to carry a memcg in the usual format,
+	 * so test that before looking at the lruvec. A folio of ours that is
+	 * off the LRU right now comes back through folio_added when it is
+	 * put back.
+	 */
+	if (!folio_test_lru(folio)) {
+		res = TES_VICTIM_INVALID;
+		goto put;
+	}
+	if (folio_lruvec(folio) != lruvec) {
+		res = TES_VICTIM_FOREIGN;
+		goto put;
+	}
+
+	file = folio_is_file_lru(folio);
+	if (folio_test_unevictable(folio) ||
+	    folio_zonenum(folio) > rc->reclaim_idx ||
+	    !(rc->victims_flags & (file ? TIER_EXT_VF_MAY_FILE :
+					  TIER_EXT_VF_MAY_ANON)) ||
+	    (!(rc->victims_flags & TIER_EXT_VF_MAY_UNMAP) &&
+	     folio_mapped(folio))) {
+		/* still the policy's: hand it back */
+		tier_ext_event(p, p->ops->folio_added, TES_VICTIM_RETURNED,
+			       folio, TIER_EXT_F_RETURNED);
+		v->nr_returned++;
+		res = TES_VICTIM_SKIPPED;
+		goto put;
+	}
+
+	/* takes its own reference and handles both engines' accounting */
+	if (!folio_isolate_lru(folio)) {
+		res = TES_VICTIM_BUSY;
+		goto put;
+	}
+	/* an isolated folio keeps its memcg, but be paranoid */
+	if (WARN_ON_ONCE(folio_lruvec(folio) != lruvec)) {
+		folio_putback_lru(folio);
+		res = TES_VICTIM_FOREIGN;
+		goto put;
+	}
+	/* shrink_folio_list() expects inactive folios, like reclaim_pages() */
+	folio_clear_active(folio);
+	node_stat_mod_folio(folio, NR_ISOLATED_ANON + file,
+			    folio_nr_pages(folio));
+	v->nr_taken[file] += folio_nr_pages(folio);
+	/* list_add(): shrink_folio_list() takes from the tail, keep the order */
+	list_add(&folio->lru, &v->list);
+	res = TES_VICTIM_ISOLATED;
+put:
+	folio_put(folio);
+	return res;
+}
+
+/*
+ * Ask @lruvec's policy for victims and isolate the valid ones onto
+ * @v->list. The caller reclaims them, hands survivors back with
+ * __tier_ext_folio_returned() and puts them back on the LRU.
+ */
+void __tier_ext_pick_victims(struct lruvec *lruvec,
+			     const struct tier_ext_reclaim *rc,
+			     struct tier_ext_victims *v)
+{
+	struct tier_ext_victims_ctx ctx;
+	struct tier_ext_policy *p;
+	u32 i, nr;
+	s32 ret;
+
+	INIT_LIST_HEAD(&v->list);
+	v->nr_taken[0] = v->nr_taken[1] = 0;
+	v->ret = 0;
+	v->nr_returned = 0;
+
+	rcu_read_lock();
+	p = rcu_dereference(lruvec->tier_ext);
+	if (!p || !p->ops->pick_victims)
+		goto out;
+
+	memset(&ctx, 0, sizeof(ctx));
+	ctx.cgroup_id = p->cgroup_id;
+	ctx.nid = lruvec_pgdat(lruvec)->node_id;
+	ctx.engine = rc->engine;
+	ctx.priority = rc->priority;
+	ctx.swappiness = rc->swappiness;
+	ctx.reclaim_flags = rc->flags;
+	ctx.flags = rc->victims_flags;
+	ctx.nr_requested = min_t(unsigned long, rc->nr_requested, U32_MAX);
+	ctx.batch = rc->batch;
+	ctx.nr_to_reclaim = rc->nr_to_reclaim;
+	ctx.nr_reclaimed = rc->nr_reclaimed;
+	ctx.nr_anon = lruvec_page_state(lruvec, NR_INACTIVE_ANON) +
+		      lruvec_page_state(lruvec, NR_ACTIVE_ANON);
+	ctx.nr_file = lruvec_page_state(lruvec, NR_INACTIVE_FILE) +
+		      lruvec_page_state(lruvec, NR_ACTIVE_FILE);
+	ctx.nr_scan_anon = rc->nr_scan_anon;
+	ctx.nr_scan_file = rc->nr_scan_file;
+
+	tes_inc(p, TES_VICTIM_CALLS);
+	ret = p->ops->pick_victims(&ctx);
+	if (ret & ~TIER_EXT_AGE) {
+		tes_inc(p, TES_INVALID);
+		ret = 0;
+	}
+	if ((ret & TIER_EXT_AGE) && (rc->victims_flags & TIER_EXT_VF_CAN_AGE)) {
+		tes_inc(p, TES_VICTIM_AGE);
+		v->ret |= TIER_EXT_AGE;
+	}
+
+	/* bpf_tier_ext_add_victim() keeps nr in bounds; don't rely on it */
+	nr = min_t(u32, ctx.nr, TIER_EXT_MAX_VICTIMS);
+	tes_add(p, TES_VICTIM_NOMINATED, nr);
+	for (i = 0; i < nr; i++)
+		tes_inc(p, tier_ext_isolate_victim(p, lruvec, ctx.pfns[i], rc, v));
+out:
+	rcu_read_unlock();
+}
