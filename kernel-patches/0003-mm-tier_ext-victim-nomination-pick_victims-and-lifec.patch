 static __always_inline void tier_ext_folio_added(struct lruvec *lruvec,
 						 struct folio *folio)
 {
 	if (tier_ext_lruvec(lruvec))
-		__tier_ext_folio_added(lruvec, folio);
+		__tier_ext_folio_added(lruvec, folio, 0);
+}
+
+/* @new_folio was split off a large folio and put on @lruvec's LRU. */
+static __always_inline void tier_ext_folio_split(struct lruvec *lruvec,
+						 struct folio *new_folio)
+{
+	if (tier_ext_lruvec(lruvec))
+		__tier_ext_folio_added(lruvec, new_folio, TIER_EXT_F_SPLIT);
+}
+
+/* Called with the lruvec's LRU lock held, @folio was just taken off it. */
+static __always_inline void tier_ext_folio_removed(struct lruvec *lruvec,
+						   struct folio *folio)
+{
+	if (tier_ext_lruvec(lruvec))
+		__tier_ext_folio_removed(lruvec, folio);
+}
+
+/* @src was migrated to @dst; called before @dst is added to an LRU. */
+static __always_inline void tier_ext_folio_migrated(struct folio *src,
+						    struct folio *dst)
+{
+	if (static_branch_unlikely(&tier_ext_attached))
+		__tier_ext_folio_migrated(src, dst);
+}
+
+static __always_inline void tier_ext_folio_referenced(struct folio *folio)
+{
+	if (static_branch_unlikely(&tier_ext_attached))
+		__tier_ext_folio_referenced(folio);
+}
+
+/* data_key of a folio about to leave memory, 0 when nobody listens */
+static __always_inline u64 tier_ext_eviction_key(struct folio *folio)
+{
+	if (static_branch_unlikely(&tier_ext_attached))
+		return tier_ext_data_key(folio);
+	return 0;
 }
 
