-void __tier_ext_folio_added(struct lruvec *lruvec, struct folio *folio)
+/*
+ * Deliver a folio event to @p. Events cannot be refused, so there is nothing
+ * to sanitize. Must be called under rcu_read_lock().
+ */
+static void tier_ext_event(struct tier_ext_policy *p,
+			   void (*op)(struct tier_ext_folio_ctx *),
+			   enum tier_ext_stat stat, struct folio *folio,
+			   u32 extra_flags)
 {
 	struct tier_ext_folio_ctx ctx;
+
+	if (!op)
+		return;
+	tier_ext_fill_folio_ctx(&ctx, p, folio, NULL);
+	ctx.folio_flags |= extra_flags;
+	tes_inc(p, stat);
+	op(&ctx);
+}
+
+void __tier_ext_folio_added(struct lruvec *lruvec, struct folio *folio,
+			    u32 extra_flags)
+{
 	struct tier_ext_policy *p;
 
 	rcu_read_lock();
 	p = rcu_dereference(lruvec->tier_ext);
-	if (p && p->ops->folio_added) {
-		tier_ext_fill_folio_ctx(&ctx, p, folio, NULL);
-		tes_inc(p, TES_ADDED);
-		p->ops->folio_added(&ctx);
-	}
+	if (p)
+		tier_ext_event(p, p->ops->folio_added, TES_ADDED, folio,
+			       extra_flags);
+	rcu_read_unlock();
+}
+
+/*
+ * A folio this lruvec's policy nominated was not reclaimed: hand it back
+ * (D21). @folio is isolated, so its lruvec is stable.
+ */
+void __tier_ext_folio_returned(struct lruvec *lruvec, struct folio *folio)
+{
+	struct tier_ext_policy *p;
+
+	rcu_read_lock();
+	p = rcu_dereference(lruvec->tier_ext);
+	if (p)
+		tier_ext_event(p, p->ops->folio_added, TES_VICTIM_RETURNED,
+			       folio, TIER_EXT_F_RETURNED);
+	rcu_read_unlock();
+}
+
+/* Called with @lruvec's LRU lock held; @folio is being freed. */
+void __tier_ext_folio_removed(struct lruvec *lruvec, struct folio *folio)
+{
+	struct tier_ext_policy *p;
+
+	rcu_read_lock();
