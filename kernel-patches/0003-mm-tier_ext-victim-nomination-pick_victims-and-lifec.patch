+	struct tier_ext_reclaim rc;
+	bool aged = false;
+
+	nr_taken[0] = nr_taken[1] = 0;
+	if (!budget || !__tier_ext_has_victims(lruvec))
+		return 0;
+
+	tier_ext_rc(&rc, sc, engine);
+	rc.swappiness = swappiness;
+	rc.reclaim_idx = sc->reclaim_idx;
+	rc.victims_flags = 0;
+	if (swappiness != SWAPPINESS_ANON_ONLY)
+		rc.victims_flags |= TIER_EXT_VF_MAY_FILE;
+	if (swappiness && sc->may_swap &&
+	    can_reclaim_anon_pages(memcg, pgdat->node_id, sc))
+		rc.victims_flags |= TIER_EXT_VF_MAY_ANON;
+	if (sc->may_unmap)
+		rc.victims_flags |= TIER_EXT_VF_MAY_UNMAP;
+	if (age)
+		rc.victims_flags |= TIER_EXT_VF_CAN_AGE;
+	rc.nr_scan_anon = scan_anon;
+	rc.nr_scan_file = scan_file;
+
+	lru_add_drain();
+
+	for (rc.batch = 0; budget; rc.batch++) {
+		unsigned long taken, reclaimed, stolen_file, kept[2] = {};
+		struct tier_ext_victims v;
+		struct reclaim_stat stat;
+		enum node_stat_item item;
+		struct folio *folio;
+		bool just_aged = false;
+
+		rc.nr_requested = budget;
+		rc.nr_reclaimed = sc->nr_reclaimed + reclaimed_total;
+		__tier_ext_pick_victims(lruvec, &rc, &v);
+		taken = v.nr_taken[0] + v.nr_taken[1];
+
+		if (taken) {
+			item = PGSCAN_KSWAPD + reclaimer_offset(sc);
+			mod_lruvec_state(lruvec, item, taken);
+			mod_lruvec_state(lruvec, PGSCAN_ANON, v.nr_taken[0]);
+			mod_lruvec_state(lruvec, PGSCAN_FILE, v.nr_taken[1]);
+
+			sc->tier_ext_nominated = 1;
+			reclaimed = shrink_folio_list(&v.list, pgdat, sc, &stat,
+						      false, memcg);
+			sc->tier_ext_nominated = 0;
+
+			/* hand the survivors back to the policy (D21) */
+			list_for_each_entry(folio, &v.list, lru) {
+				kept[folio_is_file_lru(folio)] += folio_nr_pages(folio);
+				__tier_ext_folio_returned(lruvec, folio);
+			}
+			move_folios_to_lru(&v.list);
+
+			mod_node_page_state(pgdat, NR_ISOLATED_ANON, -v.nr_taken[0]);
+			mod_node_page_state(pgdat, NR_ISOLATED_FILE, -v.nr_taken[1]);
+			mod_lruvec_state(lruvec, PGDEMOTE_KSWAPD + reclaimer_offset(sc),
+					 stat.nr_demoted);
+			item = PGSTEAL_KSWAPD + reclaimer_offset(sc);
+			mod_lruvec_state(lruvec, item, reclaimed);
